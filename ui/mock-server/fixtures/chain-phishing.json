        "Credential material may have been exfiltrated before network telemetry began capturing outbound traffic",
        "Additional workstations may have been compromised using the same ticket before DC01 authentication was observed"
      ],
      "actions": [
        "Isolate WS01 from the network immediately",
        "Reset credentials for NORTHPOLE\\Administrator and all accounts with recent Kerberos activity from WS01",
        "Search for lateral movement originating from DC01 after timestamp 1749100090",
        "Revoke all active Kerberos tickets issued to WS01 in the affected window"
      ],
      "phases": [
        { "id": "initial-access", "title": "Initial Access", "summary": "A macro-enabled Office document opened on WS01 spawned a hidden, encoded PowerShell process." },
        { "id": "credential-access", "title": "Credential Access", "summary": "The PowerShell process read LSASS memory and extracted credential material for NORTHPOLE\\Administrator." },
        { "id": "lateral-movement", "title": "Lateral Movement", "summary": "The stolen Kerberos ticket authenticated to DC01 as the domain administrator, a textbook pass-the-ticket move." },
        { "id": "privilege-escalation", "title": "Privilege Escalation", "summary": "The session on DC01 was granted SeDebug and SeTcb privileges, confirming full domain admin control." }
      ]
    }
  },
