# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# 3-VM GOAD-lite topology for the Causal Reconstruction Engine demo.
# dc01 - Domain Controller (Windows Server 2019)
# ws01 - Workstation / victim (Windows 10)
# kali - Attacker (Kali Linux)
#
# Requires: vagrant-reload, vagrant-winrm, WinRM transport gems
#   vagrant plugin install vagrant-reload

DOMAIN        = "NORTHPOLE"
DOMAIN_FQDN   = "northpole.local"
DC01_IP       = "192.168.56.10"
WS01_IP       = "192.168.56.11"
KALI_IP       = "192.168.56.12"
SPLUNK_HOST   = "192.168.56.1"   # host-only adapter on the demo machine
SPLUNK_PORT   = "9997"

Vagrant.configure("2") do |config|
  config.vm.boot_timeout = 900

  # ----------------------------------------------------------------
  # dc01 - Windows Server 2019 Domain Controller
  # ----------------------------------------------------------------
  config.vm.define "dc01" do |dc|
    dc.vm.box      = "gusztavvargadr/windows-server"
    dc.vm.box_version = "2102.0.2501"
    dc.vm.hostname = "dc01"

    dc.vm.network "private_network", ip: DC01_IP, virtualbox__intnet: "unravel-net"

    dc.vm.provider "virtualbox" do |vb|
      vb.name   = "unravel-dc01"
      vb.memory = 2048
      vb.cpus   = 2
      vb.gui    = false
      vb.customize ["modifyvm", :id, "--clipboard", "bidirectional"]
    end

    dc.vm.communicator = "winrm"
    dc.winrm.username  = "vagrant"
    dc.winrm.password  = "vagrant"

    dc.vm.provision "ansible" do |ansible|
      ansible.playbook       = "ansible/ad-setup.yml"
      ansible.inventory_path = "ansible/inventory.ini"
      ansible.extra_vars     = {
        domain:      DOMAIN,
        domain_fqdn: DOMAIN_FQDN,
        dc01_ip:     DC01_IP,
      }
    end

    dc.vm.provision "ansible" do |ansible|
      ansible.playbook       = "ansible/splunk-forwarder.yml"
      ansible.inventory_path = "ansible/inventory.ini"
      ansible.extra_vars     = {
        splunk_host: SPLUNK_HOST,
        splunk_port: SPLUNK_PORT,
      }
    end
  end

  # ----------------------------------------------------------------
  # ws01 - Windows 10 workstation (victim)
  # ----------------------------------------------------------------
  config.vm.define "ws01" do |ws|
    ws.vm.box      = "gusztavvargadr/windows-10"
    ws.vm.box_version = "2202.0.2501"
    ws.vm.hostname = "ws01"

    ws.vm.network "private_network", ip: WS01_IP, virtualbox__intnet: "unravel-net"

    ws.vm.provider "virtualbox" do |vb|
      vb.name   = "unravel-ws01"
      vb.memory = 2048
      vb.cpus   = 2
      vb.gui    = false
    end

    ws.vm.communicator = "winrm"
    ws.winrm.username  = "vagrant"
    ws.winrm.password  = "vagrant"

    ws.vm.provision "ansible" do |ansible|
      ansible.playbook       = "ansible/splunk-forwarder.yml"
      ansible.inventory_path = "ansible/inventory.ini"
      ansible.extra_vars     = {
        domain:      DOMAIN,
        domain_fqdn: DOMAIN_FQDN,
        dc01_ip:     DC01_IP,
        splunk_host: SPLUNK_HOST,
        splunk_port: SPLUNK_PORT,
      }
    end
  end

  # ----------------------------------------------------------------
  # kali - Attacker machine
  # ----------------------------------------------------------------
  config.vm.define "kali" do |k|
    k.vm.box      = "kalilinux/rolling"
    k.vm.hostname = "kali"

    k.vm.network "private_network", ip: KALI_IP, virtualbox__intnet: "unravel-net"

    k.vm.provider "virtualbox" do |vb|
      vb.name   = "unravel-kali"
      vb.memory = 1024
      vb.cpus   = 1
      vb.gui    = false
    end

    k.vm.provision "shell", inline: <<~SHELL
      apt-get update -qq
      apt-get install -y -qq python3 python3-pip smbclient impacket-scripts
      pip3 install -q pyyaml pywinrm requests
    SHELL
  end
end
